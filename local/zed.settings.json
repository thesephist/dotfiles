{
  "enable_language_server": false,
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "agent_servers": {
    "cursor": {
      "favorite_config_option_values": {
        "model": ["composer-2[fast=true]"]
      },
      "type": "registry"
    },
    "codex-acp": {
      "type": "registry",
      "default_config_options": {
        "mode": "auto"
      }
    }
  },
  "colorize_brackets": true,
  "agent": {
    "threads_sidebar": {
      "position": "right"
    },
    "use_modifier_to_send": true,
    "enable_feedback": false,
    "dock": "right",
    "default_width": 520.0,
    "flexible": false,
    "message_editor_min_lines": 8,
    "default_profile": "agent"
  },
  "buffer_font_family": "JetBrains Mono",
  "ui_font_family": ".SystemUIFont",
  "show_edit_predictions": true,
  "tab_size": 2,
  "terminal": {
    "font_family": "JetBrains Mono"
  },
  "show_signature_help_after_edits": false,
  "auto_signature_help": false,
  "multi_cursor_modifier": "cmd_or_ctrl",
  "minimap": {
    "show": "always"
  },
  "cursor_blink": false,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "base_keymap": "VSCode",
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "ui_font_size": 14,
  "buffer_font_size": 12,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Monokai-og"
  },
  "format_on_save": "off",
  "languages": {
    "JavaScript": {
      "formatter": "language_server",
      "language_servers": ["typescript-ls"]
    },
    "JSX": {
      "formatter": "language_server",
      "language_servers": ["typescript-ls"]
    },
    "TypeScript": {
      "tab_size": 2,
      "formatter": "language_server",
      "language_servers": ["typescript-ls"]
    },
    "TSX": {
      "tab_size": 2,
      "formatter": "language_server",
      "language_servers": ["typescript-ls"]
    }
  },
  "lsp": {
    "typescript-ls": {
      "settings": {
        "typescript": {
          "preferences": {
            "importModuleSpecifier": "relative"
          }
        },
        "javascript": {
          "preferences": {
            "importModuleSpecifier": "relative"
          }
        }
      }
    }
  }
}
